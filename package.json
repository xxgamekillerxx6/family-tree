{
  "name": "family-tree",
  "version": "1.0.0",
  "description": "Offline family tree maker for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Aleksandar Dekan",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aleksandardekan.familytree",
    "productName": "Family Tree",
    "files": ["main.js", "preload.js", "index.html", "style.css", "js/**"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
